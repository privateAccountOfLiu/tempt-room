{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "workspace": {
      "type": "string"
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "runId",
    "agentId",
    "workspace",
    "commit"
  ],
  "additionalProperties": {}
}
