{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wakeIntent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "discussionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "roundId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "scopeKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "agentSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "sourceEventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "sourceSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deliveryMode": {
          "type": "string",
          "enum": [
            "next-turn",
            "tool-boundary",
            "steer"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "assigned",
            "suppressed"
          ]
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "suppressionReason": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "id",
        "scopeKey",
        "agentSessionId",
        "sourceEventId",
        "sourceSeq",
        "status"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "wakeIntent"
  ],
  "additionalProperties": {}
}
