{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "success": {
      "type": "boolean"
    }
  },
  "required": [
    "runId",
    "name",
    "success"
  ],
  "additionalProperties": {}
}
