{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "executionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "hash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "const": "completed"
        },
        "result": {},
        "native": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude",
                "deepseek"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "execution",
                "tool"
              ]
            },
            "evidence": {
              "type": "string",
              "enum": [
                "execution-intent",
                "provider-notification"
              ]
            },
            "inputId": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "clientUserMessageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "turnId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "itemId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "provider",
            "scope",
            "evidence",
            "inputId",
            "kind"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "id",
        "runId",
        "roomId",
        "agentId",
        "generation",
        "executionId",
        "operationId",
        "name",
        "hash",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "clientUserMessageId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "interrupted"
          ]
        },
        "itemsView": {
          "type": "string",
          "const": "full"
        },
        "itemId": {
          "type": "string"
        },
        "itemStatus": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "declined",
            "canceled"
          ]
        }
      },
      "required": [
        "threadId",
        "turnId",
        "clientUserMessageId",
        "status",
        "itemsView"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "operation",
    "proof"
  ],
  "additionalProperties": {}
}
