{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "artifact": {
      "type": "object",
      "properties": {
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "image": {
          "type": "object",
          "properties": {
            "verified": {
              "type": "boolean",
              "const": true
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "alt": {
              "type": "string",
              "maxLength": 1000
            },
            "previewMediaType": {
              "type": "string",
              "const": "image/png"
            },
            "previewHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "previewSize": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 10485760
            }
          },
          "required": [
            "verified",
            "width",
            "height",
            "previewMediaType",
            "previewHash",
            "previewSize"
          ],
          "additionalProperties": false
        },
        "traceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "discussionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "executionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "patch",
            "report"
          ]
        },
        "mediaType": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "applied": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "id",
        "roomId",
        "name",
        "kind",
        "mediaType",
        "size",
        "createdAt",
        "applied"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "artifact"
  ],
  "additionalProperties": {}
}
