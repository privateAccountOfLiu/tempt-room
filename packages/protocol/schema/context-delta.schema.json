{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fromSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "throughSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hasMore": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mention",
          "decision",
          "lag"
        ]
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "seq": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "type": {
            "type": "string"
          },
          "actor": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "human",
                  "agent",
                  "system"
                ]
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false
          },
          "payload": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "eventId",
          "seq",
          "type",
          "actor",
          "payload"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "fromSeq",
    "throughSeq",
    "headSeq",
    "hasMore",
    "reasons",
    "changes"
  ],
  "additionalProperties": false
}
