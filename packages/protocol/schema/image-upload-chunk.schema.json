{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "uploadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 53
    },
    "dataBase64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 262144,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "uploadId",
    "index",
    "dataBase64",
    "sha256"
  ],
  "additionalProperties": false
}
