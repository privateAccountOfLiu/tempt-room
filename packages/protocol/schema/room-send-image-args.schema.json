{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "text": {
      "default": "",
      "type": "string",
      "maxLength": 32000
    },
    "alt": {
      "type": "string",
      "maxLength": 1000
    },
    "mentions": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9_-]+$"
      }
    },
    "replyTo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "operationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    }
  },
  "required": [
    "path",
    "text",
    "mentions",
    "operationId"
  ],
  "additionalProperties": false
}
