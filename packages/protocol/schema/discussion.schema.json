{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "roomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "goal": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9_-]+$"
      }
    },
    "rounds": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "round": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxResponses": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "responses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "quorum": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "absent": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9_-]+$"
      }
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed",
        "stopped"
      ]
    },
    "triggerPolicy": {
      "type": "string",
      "enum": [
        "all",
        "explicit",
        "assigned-task"
      ]
    },
    "activationLimit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "activationsUsed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "summaryActivationLimit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "summaryActivationsUsed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "roundWindowMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "activeRoundId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "authorizationRef": {
      "type": "string",
      "maxLength": 300
    },
    "lifecycleVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "stopOnConvergence": {
      "type": "boolean"
    },
    "summarizerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "startedSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endedSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "endReason": {
      "type": "string",
      "enum": [
        "converged",
        "round_limit",
        "response_limit",
        "time_limit",
        "no_quorum",
        "user_stop",
        "restart",
        "scheduling_failed",
        "budget_exhausted",
        "activation_limit"
      ]
    },
    "consensus": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "text": {
          "type": "string",
          "maxLength": 12000
        },
        "round": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "agreedBy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_-]+$"
          }
        }
      },
      "required": [
        "proposalId",
        "text",
        "round",
        "agreedBy"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "completed",
            "failed",
            "canceled",
            "interrupted"
          ]
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "roomId",
    "goal",
    "participants",
    "rounds",
    "round",
    "maxResponses",
    "responses",
    "deadline",
    "status"
  ],
  "additionalProperties": {}
}
