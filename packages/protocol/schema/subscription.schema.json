{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "roomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "agentSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "eventTypes": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "taskIds": {
      "default": [],
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9_-]+$"
      }
    },
    "sourcePolicy": {
      "type": "string",
      "enum": [
        "explicit",
        "assigned-task",
        "previous-response"
      ]
    },
    "deliveryMode": {
      "type": "string",
      "enum": [
        "next-turn",
        "tool-boundary",
        "steer"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "scanSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "roomId",
    "agentSessionId",
    "eventTypes",
    "taskIds",
    "sourcePolicy",
    "enabled",
    "scanSeq"
  ],
  "additionalProperties": false
}
