{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "baseSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "throughSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hasMore": {
      "type": "boolean"
    },
    "policy": {
      "type": "object",
      "properties": {
        "maxLag": {
          "default": 64,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxRounds": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "maxDeltaBytes": {
          "default": 262144,
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        }
      },
      "required": [
        "maxLag",
        "maxRounds",
        "maxDeltaBytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "token",
    "baseSeq",
    "throughSeq",
    "hasMore",
    "policy"
  ],
  "additionalProperties": false
}
