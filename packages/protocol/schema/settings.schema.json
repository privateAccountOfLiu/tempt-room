{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contextPolicy": {
      "default": {
        "maxLag": 64,
        "maxRounds": 3,
        "maxDeltaBytes": 262144
      },
      "type": "object",
      "properties": {
        "maxLag": {
          "default": 64,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxRounds": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "maxDeltaBytes": {
          "default": 262144,
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        }
      },
      "required": [
        "maxLag",
        "maxRounds",
        "maxDeltaBytes"
      ],
      "additionalProperties": false
    },
    "concurrency": {
      "default": 2,
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "maxConcurrentRunsPerRoom": {
      "default": 4,
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "memoryMb": {
      "default": 4096,
      "type": "integer",
      "minimum": 256,
      "maximum": 16384
    },
    "maxProcesses": {
      "default": 64,
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "taskTimeoutMs": {
      "default": 1800000,
      "type": "integer",
      "minimum": 1000,
      "maximum": 7200000
    },
    "chatTimeoutMs": {
      "default": 300000,
      "type": "integer",
      "minimum": 1000,
      "maximum": 7200000
    },
    "taskLeaseMs": {
      "default": 600000,
      "type": "integer",
      "minimum": 5000,
      "maximum": 86400000
    },
    "tokenBudget": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "costBudgetUsd": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "maxQueuedRunsPerAgent": {
      "default": 5,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "maxQueuedRunsPerRoom": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "maxAgentRunsPerMinute": {
      "default": 30,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maxBypassDispatches": {
      "default": 5,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maxInboxDeliveries": {
      "default": 1000,
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "maxInboxBytes": {
      "default": 1048576,
      "type": "integer",
      "minimum": 1024,
      "maximum": 67108864
    },
    "allowAgentMentionsToWake": {
      "default": false,
      "type": "boolean"
    },
    "maxWakeChainDepth": {
      "default": 2,
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "maxToolResultBytes": {
      "default": 2097152,
      "type": "integer",
      "minimum": 65536,
      "maximum": 8388608
    },
    "maxToolCallsPerRun": {
      "default": 100,
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "maxContextMessages": {
      "default": 40,
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "autoRetryChatRuns": {
      "default": false,
      "type": "boolean"
    },
    "recoverInterruptedChatRuns": {
      "default": false,
      "type": "boolean"
    },
    "maxAutoRetries": {
      "default": 1,
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "adaptiveTimeouts": {
      "default": false,
      "type": "boolean"
    },
    "roomTokenBudget": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "roomCostBudgetUsd": {
      "default": 0,
      "type": "number",
      "minimum": 0,
      "maximum": 1000000
    },
    "unknownCostPolicy": {
      "default": "block",
      "type": "string",
      "enum": [
        "block",
        "allow"
      ]
    },
    "stagingRetentionMs": {
      "default": 86400000,
      "type": "integer",
      "minimum": 0,
      "maximum": 2592000000
    },
    "toolAuthorizationMode": {
      "default": "off",
      "type": "string",
      "enum": [
        "off",
        "warn",
        "enforce"
      ]
    }
  },
  "required": [
    "contextPolicy",
    "concurrency",
    "maxConcurrentRunsPerRoom",
    "memoryMb",
    "maxProcesses",
    "taskTimeoutMs",
    "chatTimeoutMs",
    "taskLeaseMs",
    "tokenBudget",
    "costBudgetUsd",
    "maxQueuedRunsPerAgent",
    "maxQueuedRunsPerRoom",
    "maxAgentRunsPerMinute",
    "maxBypassDispatches",
    "maxInboxDeliveries",
    "maxInboxBytes",
    "allowAgentMentionsToWake",
    "maxWakeChainDepth",
    "maxToolResultBytes",
    "maxToolCallsPerRun",
    "maxContextMessages",
    "autoRetryChatRuns",
    "recoverInterruptedChatRuns",
    "maxAutoRetries",
    "adaptiveTimeouts",
    "roomTokenBudget",
    "roomCostBudgetUsd",
    "unknownCostPolicy",
    "stagingRetentionMs",
    "toolAuthorizationMode"
  ],
  "additionalProperties": false
}
