{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposalId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "agree": {
      "type": "boolean"
    },
    "proposal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    }
  },
  "required": [
    "proposalId",
    "agree",
    "proposal"
  ],
  "additionalProperties": false
}
