{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "maxLag": {
      "default": 64,
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "maxRounds": {
      "default": 3,
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "maxDeltaBytes": {
      "default": 262144,
      "type": "integer",
      "minimum": 4096,
      "maximum": 1048576
    }
  },
  "required": [
    "maxLag",
    "maxRounds",
    "maxDeltaBytes"
  ],
  "additionalProperties": false
}
