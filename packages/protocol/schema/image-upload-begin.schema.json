{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ]
    },
    "alt": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "size",
    "sha256"
  ],
  "additionalProperties": false
}
