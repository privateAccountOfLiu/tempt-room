{
  "name": "tempt-room",
  "version": "0.1.0",
  "description": "Windows-native local multi-agent collaboration workspace with rooms, tasks, MCP and A2A adapters.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/privateAccountOfLiu/tempt-room.git"
  },
  "homepage": "https://github.com/privateAccountOfLiu/tempt-room#readme",
  "bugs": { "url": "https://github.com/privateAccountOfLiu/tempt-room/issues" },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx apps/server/src/main.ts",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "build": "npm run typecheck && npm run build:sdk && vite build && tsup apps/server/src/main.ts --format esm --platform node --out-dir dist/server --external node:sqlite --external vite",
    "build:sdk": "tsup packages/protocol/src/index.ts --format esm --dts --out-dir packages/protocol/dist && tsup packages/client/src/index.ts --format esm --dts --out-dir packages/client/dist && tsx scripts/schema.ts",
    "build:sandbox": "dotnet build sandbox/RoomSandbox/RoomSandbox.csproj -c Release --nologo && npm run build:pipe-compat",
    "build:pipe-compat": "node scripts/build-pipe-compat.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:replay": "tsx --test tests/event-replay.test.ts tests/event-cursor.test.ts tests/execution-fencing.test.ts tests/run-partial.test.ts tests/context-reconciliation.test.ts tests/external-context.test.ts tests/recovery-proof.test.ts tests/native-operations.test.ts",
    "test:fencing-native": "tsx scripts/probe-execution-fencing.ts",
    "test:sandbox": "tsx scripts/probe-sandbox.ts",
    "test:agent-protocols": "tsx scripts/probe-agents.ts",
    "test:connectors": "tsx scripts/probe-connectors.ts",
    "test:sdk": "npm run build:sdk && node scripts/probe-sdk.mjs",
    "test:browser-fixture": "tsx scripts/preview-regressions.ts",
    "test:browser": "tsx scripts/browser-e2e.ts",
    "test:production": "tsx scripts/production-smoke.ts",
    "test:preflight": "tsx scripts/preflight.ts",
    "report:readiness": "tsx scripts/release-readiness.ts",
    "test:agents": "tsx scripts/smoke-agents.ts",
    "test:claude": "tsx scripts/smoke-claude.ts",
    "test:codex": "tsx scripts/smoke-codex.ts",
    "test:codex-attach": "tsx --test tests/codex-attach.test.ts",
    "test:codex-attach-native": "tsx scripts/probe-codex-attach-native.ts",
    "codex:check-attach": "tsx scripts/check-codex-attachment.ts",
    "test:deepseek": "tsx scripts/smoke-deepseek.ts",
    "test:external-mcp": "node scripts/check-external-mcp.mjs",
    "test:team-host": "tsx scripts/smoke-team-host.ts",
    "room:refresh-claude": "node scripts/refresh-claude-mcp.mjs",
    "room:refresh-codex": "node scripts/refresh-codex-mcp.mjs",
    "open": "node scripts/open-room.mjs",
    "test:acceptance": "tsx scripts/acceptance-agents.ts",
    "check:node-build-tools": "node scripts/build-node-runtime.mjs --check-tools",
    "build:sandbox-node": "node scripts/build-node-runtime.mjs",
    "test:host-task": "tsx scripts/smoke-host-task.ts",
    "test:host-commands": "tsx scripts/smoke-host-commands.ts",
    "test:host-cancel": "tsx scripts/smoke-host-cancel.ts",
    "test:host-handoff": "tsx scripts/smoke-host-handoff.ts",
    "test:runner": "node scripts/smoke-runner.mjs",
    "test:runner-real": "node scripts/smoke-runner-real.mjs",
    "test:sandbox-artifact": "tsx scripts/smoke-sandbox-artifact.ts",
    "backup": "node scripts/backup-state.mjs",
    "restore": "node scripts/restore-state.mjs",
    "dev:open": "node scripts/dev-open.mjs",
    "test:sandbox-handoff": "tsx scripts/smoke-sandbox-handoff.ts",
    "test:faults": "tsx --test tests/fault-injection.test.ts",
    "test:concurrency": "tsx --test tests/concurrency-conflict.test.ts",
    "verify:collaboration": "tsx scripts/verify-collaboration-baseline.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.1",
    "katex": "^0.18.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
