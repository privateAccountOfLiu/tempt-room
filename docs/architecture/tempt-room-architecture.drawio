belBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="host" target="nativecli" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge24" value="CLI 自行访问模型" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#60738A;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#465B73;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" source="nativecli" target="internet" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge25" value="公网 HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#60738A;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#465B73;labelBackgroundColor=#FFFFFF;" edge="1" source="remote" target="internet" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#60738A;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#465B73;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;" edge="1" source="protocol" target="sdk" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note0" value="边界说明" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontColor=#172B45;fontSize=16;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="300" height="28" as="geometry" /></mxCell><mxCell id="note1" value="实线：调用、执行或状态流&#10;虚线：上下文依赖或临时流片段&#10;服务模块同进程；没有消息中间件。&#10;SQLite 的 runs 表就是持久队列。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontColor=#172B45;fontSize=13;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="300" height="95" as="geometry" /></mxCell><mxCell id="note2" value="执行模式必须区分" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontColor=#172B45;fontSize=16;fontStyle=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="945" width="300" height="28" as="geometry" /></mxCell><mxCell id="note3" value="沙箱：隔离工作区，审阅后应用。&#10;host：可直接修改真实项目。&#10;external：房间服务不管理其进程。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontColor=#172B45;fontSize=13;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="300" height="95" as="geometry" /></mxCell><mxCell id="note4" value="数据库保存索引、实体与事件；&#10;大文件正文保存在状态目录。&#10;密钥通过环境变量引用注入。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontColor=#172B45;fontSize=13;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1120" y="540" width="300" height="95" as="geometry" /></mxCell><mxCell id="note5" value="Room Protocol 是应用契约；MCP 是工具接入；ACP / App Server / A2A 分别适配 Agent 原生接口。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontColor=#172B45;fontSize=13;fontStyle=0;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="400" y="1105" width="1050" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="execution" name="执行路径与成果落地"><mxGraphModel dx="1540" dy="1140" grid="1" gridSize="10" page="1" pageWidth="1540" pageHeight="1140" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="执行路径与成果落地" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontColor=#172B45;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1460" height="40" as="geometry" /></mxCell><mxCell id="subtitle" value="四条代码路径分别展示 · 不把本